{
  "name": "agentgate",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @agentgate/web",
    "build": "npm run build --workspace @agentgate/web",
    "start": "npm run start --workspace @agentgate/web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p packages/controller && tsc --noEmit -p apps/web",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "test:e2e": "playwright test",
    "scanner:setup": "sh scanner/setup.sh",
    "scanner": "scanner/.venv/bin/python scanner/server.py",
    "eval": "cd evals && NODE_OPTIONS=--import=tsx PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval --no-cache --no-write --no-progress-bar -c promptfooconfig.yaml",
    "eval:weak": "cd evals && NODE_OPTIONS=--import=tsx PROMPTFOO_DISABLE_TELEMETRY=1 PROMPTFOO_DISABLE_UPDATE=1 promptfoo eval --no-cache --no-write --no-progress-bar -c weak.promptfooconfig.yaml"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "promptfoo": "0.125.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module",
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3",
    "basic-ftp": "6.2.5"
  }
}
